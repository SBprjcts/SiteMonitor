# Which sections use the in-memory mock instead of the backend:
#   true (default)  every section is mocked, no backend needed
#   false           nothing is mocked, everything calls the backend on :8000
#   watches         only the listed sections are mocked (comma-separated:
#                   stores, products, watches). Use this while some endpoints don't exist yet.
VITE_USE_MOCKS=true
