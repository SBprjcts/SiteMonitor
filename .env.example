# Copy to .env (in the repo root) and fill in. Never commit .env.
# DATABASE_URL defaults to backend/sitemonitor.db. Set it only for Postgres or another path.
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/sitemonitor.db
MONITOR_ENABLED=true
DEFAULT_HOT_INTERVAL_S=15
DEFAULT_SWEEP_INTERVAL_S=60
DOMAIN_MIN_REQUEST_GAP_S=2
ALERT_COOLDOWN_S=300
SESSION_SECRET=change-me
LOG_LEVEL=INFO
